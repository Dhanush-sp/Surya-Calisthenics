  const AUTO_SCROLL_SPEED = 0.6; // px per frame

  useEffect(() => {
    if (items.length === 0) return;

    const tick = () => {
      const w = setWidthRef.current;
      if (w > 0) {
        if (isDraggingRef.current) {
